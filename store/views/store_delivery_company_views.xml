<odoo>
    <record id="view_store_delivery_company_form" model="ir.ui.view">
        <field name="name">store.delivery.company.form</field>
        <field name="model">store.delivery.company</field>
        <field name="arch" type="xml">
            <form string="Delivery Company Form">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" nolabel="1" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="usual_delivery_time"/>                            
                        </group>
                        <group>
                            <field name="delivery_rating"/>
                        </group>                     
                    </group>
                    <notebook>
                        <page string="Informations">
                            <group>
                                <group>
                                    <field name="phone"/>
                                    <field name="email"/>
                                    <field name="address"/>                            
                                </group>
                                <group>
                                    <field name="contact_name"/>                            
                                </group>
                            </group>                            
                        </page>
                        <page string="Orders">
                            <field name="order_ids" readonly="1">
                                <list>
                                    <field name="article_id"/>
                                    <field name="total_amount"/>
                                    <field name="order_date"/>
                                    <field name="delivery_status"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_store_delivery_company" model="ir.actions.act_window">
        <field name="name">Delivery Companies</field>
        <field name="res_model">store.delivery.company</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_store_delivery_company" name="Delivery Company" parent="menu_store_settings" action="action_store_delivery_company" sequence="41"/>
</odoo>