<odoo>
    <record id="view_store_order_list" model="ir.ui.view">
        <field name="name">store.order.list</field>
        <field name="model">store.order</field>
        <field name="arch" type="xml">
            <list string="Orders">
                <field name="article_id"/>
                <field name="total_amount"/>
                <field name="supply_company_id"/>
                <field name="delivery_company_id"/>
                <field name="delivery_status"/>
                <field name="order_date"/>
                <field name="expected_delivery_date"/>
            </list>
        </field>
    </record>

    <record id="view_store_order_form" model="ir.ui.view">
        <field name="name">store.order.form</field>
        <field name="model">store.order</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="number"/>
                        </group>
                        <group>
                            <field name="tracking_url"/>
                        </group>
                    </group>
                    <group>
                        <field name="article_id"/>
                        <field name="total_amount"/>
                    </group>
                    <group>
                        <group>
                            <field name="order_date"/>
                            <field name="expected_delivery_date"/>
                        </group>
                        <group>
                            <field name="delivery_date"/>
                        </group>
                    </group>
                    <group>
                        <field name="delivery_status"/>
                    </group>
                    <group>
                        <field name="supply_company_id"/>
                        <field name="delivery_company_id"/>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>                
        </field>
    </record>

    <record id="action_store_order" model="ir.actions.act_window">
        <field name="name">Orders</field>
        <field name="res_model">store.order</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_store_order" name="Orders" parent="menu_store_root" action="action_store_order" sequence="30"/>
</odoo>