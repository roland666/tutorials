<odoo>
    <record id="view_cinema_genre_list" model="ir.ui.view">
        <field name="name">cinema.genre.list</field>
        <field name="model">cinema.genre</field>
        <field name="arch" type="xml">
            <list string="List of genres">
                <field name="name"/>
            </list>
        </field>
    </record>    
    
    <record id="view_cinema_genre_form" model="ir.ui.view">
        <field name="name">cinema.genre.form</field>
        <field name="model">cinema.genre</field>
        <field name="arch" type="xml">
            <form string="New Genre">
                <sheet>
                    <field name="name"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cinema_genre" model="ir.actions.act_window">
        <field name="name">Genres</field>
        <field name="res_model">cinema.genre</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_cinema_genre" name="Genres" parent="menu_cinema_settings" sequence="21" action="action_cinema_genre" groups="base.group_system"/>
</odoo>