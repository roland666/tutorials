<odoo>
    <record id="view_cinema_review_list" model="ir.ui.view">
        <field name="name">cinema.review.list</field>
        <field name="model">cinema.review</field>
        <field name="arch" type="xml">
            <list string="List of reviews">
                    <field name="user_id"/>
                    <field name="rating" widget="rating"/>
                    <field name="comment"/>
            </list>
        </field>
    </record>    
    
    <record id="view_cinema_review_form" model="ir.ui.view">
        <field name="name">cinema.review.form</field>
        <field name="model">cinema.review</field>
        <field name="arch" type="xml">
            <form string="New Review">
                <sheet>
                    <group>
                        <field name="rating"/>
                    </group>
                    <field name="comment" placeholder="Write a comment here"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cinema_review" model="ir.actions.act_window">
        <field name="name">Reviews</field>
        <field name="res_model">cinema.review</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_cinema_review" name="Reviews" parent="menu_cinema_settings" sequence="24" action="action_cinema_review" groups="base.group_system"/>
</odoo>