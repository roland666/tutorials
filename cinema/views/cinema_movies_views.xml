<odoo>    
    <record id="view_cinema_movie_form" model="ir.ui.view">
        <field name="name">cinema.movie.form</field>
        <field name="model">cinema.movie</field>
        <field name="arch" type="xml">
            <form string="Movie">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Movie title"/>
                        </h1>
                    </div>
                    <group>
                        <field name="genre_ids" widget='many2many_tags'/>                            
                    </group>
                    <group>
                        <field name="average_rating" readonly="1"/>
                    </group>
                    <group>
                        <field name="year" widget="integer"/>
                        <field name="duration"/>
                    </group>
                    <group>
                        <field name="production_company_id"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>                    
                    <notebook>
                        <page string="People (All)">
                            <field name="movie_person_ids">
                                <list editable="bottom">
                                    <field name="person_id"/>
                                    <field name="role"/>
                                </list>
                            </field>
                        </page>
                        <page string="Actors">
                            <field name="actor_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Producers">
                            <field name="producer_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Realisators">
                            <field name="realisator_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Reviews">
                        <group>
                            <field name="review_ids" widget="one2many_list" readonly="1"/>
                            <button name="action_create_review"
                                    type="object"
                                    string="Add Review"
                                    class="btn-primary"
                                    invisible="not can_add_review"/>
                            <button name="action_modify_review"
                                    type="object"
                                    string="Modify Review"
                                    class="btn-primary"
                                    invisible="can_add_review"/>
                            <button name="action_delete_review"
                                    type="object"
                                    string="Delete Review"
                                    class="btn-primary"
                                    invisible="can_add_review"/>
                        </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cinema_movie_list" model="ir.ui.view">
        <field name="name">cinema.movie.list</field>
        <field name="model">cinema.movie</field>
        <field name="arch" type="xml">
            <list string="Movies list">
                <field name="name" width="20%"/>
                <field name="genre_ids" widget='many2many_tags' width="20%"/>
                <field name="average_rating"/>
                <field name="year"/>
                <field name="duration"/>
            </list>
        </field>
    </record>
</odoo>