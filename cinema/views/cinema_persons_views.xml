<odoo>
    <record id="view_cinema_person_list" model="ir.ui.view">
        <field name="name">cinema.person.list</field>
        <field name="model">cinema.person</field>
        <field name="arch" type="xml">
            <list string="List of persons">
                <field name="name"/>
                <field name="birthdate"/>
                <field name="biography"/>
            </list>
        </field>
    </record>    
    
    <record id="view_cinema_person_form" model="ir.ui.view">
        <field name="name">cinema.person.form</field>
        <field name="model">cinema.person</field>
        <field name="arch" type="xml">
            <form string="New Person">
                <sheet>
                    <field name="name"/>
                    <field name="birthdate"/>
                    <field name="biography"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cinema_person" model="ir.actions.act_window">
        <field name="name">Persons</field>
        <field name="res_model">cinema.person</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_cinema_person" 
                name="Persons" 
                parent="menu_cinema_settings" 
                sequence="23" 
                action="action_cinema_person"
                groups="base.group_system"/>
</odoo>