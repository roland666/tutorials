<odoo>
    <record id="view_cinema_production_company_list" model="ir.ui.view">
        <field name="name">cinema.production.company.list</field>
        <field name="model">cinema.production.company</field>
        <field name="arch" type="xml">
            <list string="List of production companies">
                <field name="name"/>
            </list>
        </field>
    </record>    
    
    <record id="view_cinema_production_company_form" model="ir.ui.view">
        <field name="name">cinema.production.company.form</field>
        <field name="model">cinema.production.company</field>
        <field name="arch" type="xml">
            <form string="New Production Company">
                <sheet>
                    <field name="name"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cinema_production_company" model="ir.actions.act_window">
        <field name="name">Production Companies</field>
        <field name="res_model">cinema.production.company</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_cinema_production_company" 
                name="Production Companies" 
                parent="menu_cinema_settings" 
                sequence="22" 
                action="action_cinema_production_company"
                groups="base.group_system"/>
</odoo>